---
// A small crayon picture for each part of the day, drawn with the same thick ink outline as the toy blocks.
interface Props {
  name: 'arrive' | 'tea' | 'story' | 'garden' | 'lunch' | 'rest' | 'snack' | 'home';
}

const { name } = Astro.props;
const ink = { stroke: 'var(--art-ink)', 'stroke-width': 2.5, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' };
---

<svg class="rv-day__icon" viewBox="0 0 64 64" aria-hidden="true">
  {name === 'arrive' && (
    <>
      <path d="M12 30 32 12l20 18" fill="var(--crayon-red)" {...ink} />
      <path d="M16 28h32v26H16Z" fill="var(--crayon-yellow)" {...ink} />
      <path d="M27 54V40h10v14" fill="var(--crayon-blue)" {...ink} />
      <path d="M32 33c-2-3-6-1-4 2l4 3 4-3c2-3-2-5-4-2Z" fill="var(--crayon-red)" stroke="none" />
    </>
  )}
  {name === 'tea' && (
    <>
      <path d="M24 10q-4 5 0 9M32 8q-4 6 0 11M40 10q-4 5 0 9" fill="none" {...ink} />
      <path d="M12 24h34v14a14 14 0 0 1-14 14h-6a14 14 0 0 1-14-14Z" fill="var(--crayon-orange)" {...ink} />
      <path d="M46 28h4a6 6 0 0 1 0 12h-5" fill="none" {...ink} />
      <path d="M10 56h40" fill="none" {...ink} />
    </>
  )}
  {name === 'story' && (
    <>
      <path d="M32 20q-10-6-24-4v34q14-2 24 4Z" fill="var(--crayon-purple)" {...ink} />
      <path d="M32 20q10-6 24-4v34q-14-2-24 4Z" fill="var(--art-paper)" {...ink} />
      <path d="M41 42V28l8-2v12" fill="none" {...ink} />
      <circle cx="39" cy="43" r="3" fill="var(--art-ink)" />
      <circle cx="47" cy="39" r="3" fill="var(--art-ink)" />
    </>
  )}
  {name === 'garden' && (
    <>
      <path d="M4 54q28-10 56 0v6H4Z" fill="var(--crayon-green)" {...ink} />
      <path d="M32 52V28" fill="none" {...ink} />
      <path d="M32 44q-10-2-12-10 10 0 12 8M32 40q10-2 12-10-10 0-12 8" fill="var(--crayon-green)" {...ink} />
      <g fill="var(--crayon-red)" {...ink}>
        <circle cx="32" cy="12" r="6" /><circle cx="40" cy="19" r="6" /><circle cx="32" cy="26" r="6" /><circle cx="24" cy="19" r="6" />
      </g>
      <circle cx="32" cy="19" r="4.5" fill="var(--crayon-yellow)" {...ink} />
    </>
  )}
  {name === 'lunch' && (
    <>
      <path d="M22 18q-4-5 0-10M32 18q-4-5 0-10M42 18q-4-5 0-10" fill="none" {...ink} />
      <path d="M14 30q4-6 18-6t18 6" fill="var(--crayon-yellow)" {...ink} />
      <path d="M6 30h52a26 22 0 0 1-52 0Z" fill="var(--crayon-blue)" {...ink} />
      <circle cx="24" cy="27" r="2" fill="var(--crayon-green)" /><circle cx="38" cy="26" r="2" fill="var(--crayon-red)" />
    </>
  )}
  {name === 'rest' && (
    <>
      <path d="M36 10a22 22 0 1 0 18 34A18 18 0 0 1 36 10Z" fill="var(--crayon-yellow)" {...ink} />
      <path d="M44 8h8l-8 8h8M50 22h6l-6 6h6" fill="none" {...ink} />
      <circle cx="24" cy="34" r="2.5" fill="var(--art-ink)" />
      <path d="M20 42q5 4 10 0" fill="none" {...ink} />
    </>
  )}
  {name === 'snack' && (
    <>
      <path d="M32 18q-2-8 4-12" fill="none" {...ink} />
      <path d="M34 12q8-6 14 0-6 6-14 0Z" fill="var(--crayon-green)" {...ink} />
      <path d="M32 20q-8-6-16 0-8 8-2 22 6 14 14 12h8q8 2 14-12 6-14-2-22-8-6-16 0Z" fill="var(--crayon-red)" {...ink} />
      <path d="M22 28q-3 4-2 10" fill="none" stroke="var(--art-paper)" stroke-width="3" stroke-linecap="round" />
    </>
  )}
  {name === 'home' && (
    <>
      <path d="M8 46V36l8-10h22l10 10h8v10Z" fill="var(--crayon-orange)" {...ink} />
      <path d="M20 30h8v6H18ZM32 30h4l6 6H32Z" fill="var(--crayon-sky)" {...ink} />
      <circle cx="20" cy="48" r="6" fill="var(--art-ink)" /><circle cx="46" cy="48" r="6" fill="var(--art-ink)" />
      <circle cx="20" cy="48" r="2" fill="var(--art-paper)" /><circle cx="46" cy="48" r="2" fill="var(--art-paper)" />
    </>
  )}
</svg>
