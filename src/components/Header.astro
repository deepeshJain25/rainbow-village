---
import site from '../content/site.json';
import CrayonWord from './CrayonWord.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const isCurrent = (item: { href: string; children?: { href: string }[] }) =>
  item.href === path || item.children?.some((child) => child.href === path);
---

<header data-theme="kraft">
  <div class="hs-strip">
    <span class="rv-with-icon rv-strip-wide"><Icon name="map-pin" />{site.shortAddress}</span>
    <span class="rv-with-icon rv-strip-wide"><Icon name="clock" />{site.shortHours}</span>
    <span class="rv-with-icon rv-strip-phone"><Icon name="clock" />{site.phoneHours}</span>
    <a class="rv-with-icon" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
  </div>
  <nav class="hs-nav" aria-label="Main">
    <a class="hs-nav__home" href="/" aria-label={`${site.name} home`}><CrayonWord /></a>

    <ul class="hs-nav__links rv-nav-links">
      {site.nav.map((item) => (
        <li class:list={{ 'rv-has-sub': item.children }}>
          <a
            href={item.href}
            aria-current={isCurrent(item) ? 'page' : undefined}
            aria-expanded={item.children ? 'false' : undefined}
          >
            {item.label}{item.children && <span class="rv-caret" aria-hidden="true">▾</span>}
          </a>
          {item.children && (
            <ul class="rv-sub">
              {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <div class="rv-nav-actions">
      <a class="hs-btn hs-btn--orange rv-nav-book" href="/book-a-tour">Book a tour</a>
      <details class="rv-menu">
        <summary class="hs-btn"><span class="rv-menu__open">Menu</span><span class="rv-menu__close">Close</span></summary>
        <ul class="rv-menu__panel">
          {site.nav.map((item) => (
            <li>
              <a class="rv-menu__top" href={item.href}>{item.label}</a>
              {item.children && (
                <ul>
                  {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  // Dropdowns open on click as well as hover. Without JavaScript the link goes to its page.
  const items = [...document.querySelectorAll('.rv-has-sub')];
  const setOpen = (item: Element, open: boolean) => {
    item.classList.toggle('is-open', open);
    item.querySelector(':scope > a')?.setAttribute('aria-expanded', String(open));
  };

  for (const item of items) {
    item.querySelector(':scope > a')?.addEventListener('click', (event) => {
      event.preventDefault();
      const open = !item.classList.contains('is-open');
      items.forEach((other) => setOpen(other, false));
      setOpen(item, open);
    });
  }
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('.rv-has-sub')) items.forEach((item) => setOpen(item, false));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') items.forEach((item) => setOpen(item, false));
  });
</script>
