---
// A day on the ruled lines: the parts of the day, in order.
import Todo from './Todo.astro';

interface Props {
  title: string;
  lead?: string;
  items?: string[];
  note?: string;
}

const { title, lead, items = [], note } = Astro.props;
---

<section class="hs-sheet" data-theme="crayon">
  <div class="rv-wrap rv-sheet-body">
    <h2>{title}</h2>
    {lead && <p><Todo text={lead} /></p>}
    {items.length > 0 && (
      <ol class="rv-list rv-list--numbered">
        {items.map((activity) => <li>{activity}</li>)}
      </ol>
    )}
    {note && <p><Todo text={note} /></p>}
  </div>
</section>
