---
// A room as a child's painting pegged to the washing line. The whole painting is the link.
interface Props {
  title: string;
  ages: string;
  text: string;
  href: string;
  crayon: 'purple' | 'yellow' | 'orange';
}

const { title, ages, text, href, crayon } = Astro.props;
---

<a class:list={['hs-painting', 'rv-room-card', crayon !== 'yellow' && `hs-painting--${crayon}`]} data-theme="crayon" href={href}>
  <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>
  <p class="hs-painting__title">{title}</p>
  <span class={`hs-tape hs-tape--${crayon}`}><span class="hs-tape__dab"></span>{ages}</span>
  <p class="hs-painting__caption">{text}</p>
</a>
