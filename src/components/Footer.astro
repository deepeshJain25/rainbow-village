---
import site from '../content/site.json';
import CrayonWord from './CrayonWord.astro';

const year = new Date().getFullYear();
// These two pages already have the action on screen.
const showBar = !['/book-a-tour', '/contact'].includes(Astro.url.pathname.replace(/\/$/, ''));
---

<footer class="hs-ground rv-footer" data-theme="chalkboard">
  <div class="rv-wrap rv-footer__grid">
    <div class="rv-footer__col">
      <CrayonWord />
      <p class="rv-footer__heading">Visit</p>
      <p>{site.address}</p>
      <p>{site.hours}</p>
      <p><a href={site.phoneHref}>{site.phone}</a></p>
      <p><mark class="rv-todo">[email]</mark></p>
      <p><a href={site.mapUrl}>Get directions</a></p>
    </div>
    <div>
      <p class="rv-footer__heading">Pages</p>
      <ul class="rv-footer__links rv-footer__pages">
        {site.pages.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
    <div class="rv-footer__col">
      <p class="rv-footer__heading">Families</p>
      <p><a href={site.reviewsUrl}>{site.rating}</a></p>
      <p><mark class="rv-todo">[Parent app for iPhone]</mark></p>
      <p><mark class="rv-todo">[Parent app for Android]</mark></p>
      <p><mark class="rv-todo">[Child Care Subsidy approved: wording from the centre]</mark></p>
    </div>
  </div>
  <p class="rv-wrap rv-footer__legal">
    © {year} {site.legalName} · <mark class="rv-todo">[ABN]</mark> · <a href="/privacy-policy">Privacy policy</a>
  </p>
</footer>

{showBar && (
  <div class="rv-mobile-bar" data-theme="kraft">
    <a class="hs-btn hs-btn--orange" href="/book-a-tour">Book a tour</a>
    <a class="hs-btn hs-btn--yellow" href={site.phoneHref}>Call</a>
  </div>
)}
