---
import PaintingArt from './PaintingArt.astro';
import Todo from './Todo.astro';

// A photo hung as a painting: one of the centre's photos when `photo` names a file in src/assets/photos,
// otherwise the crayon placeholder. A caption is the final copy under it; a label notes a photo still to come.
interface Props {
  label?: string;
  caption?: string;
  photo?: string;
  sizes?: string;
  crayon?: 'purple' | 'orange' | 'blue' | 'red';
  taped?: boolean;
}

const { label, caption, photo, sizes, crayon, taped = false } = Astro.props;
---

<figure class:list={['hs-painting', 'rv-photo', crayon && `hs-painting--${crayon}`, { 'rv-taped': taped }]} data-theme="crayon">
  <PaintingArt photo={photo} sizes={sizes} />
  <figcaption class="hs-painting__caption">{caption ? <Todo text={caption} /> : <mark class="rv-todo">[{label}]</mark>}</figcaption>
</figure>
