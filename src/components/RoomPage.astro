---
// The shared room page frame: header, at a glance, photos and the closing band. Each room page writes
// its own sections in between, in the order its copy sets.
import Layout from '../layouts/Layout.astro';
import Closing from './Closing.astro';
import PageHeader from './PageHeader.astro';
import Photo from './Photo.astro';
import Todo from './Todo.astro';

interface Props {
  room: { name: string; ages: string; crayon: string };
  seo: { title: string; description: string };
  heading: string;
  lead: string;
  // Each fact in the at-a-glance row. Bold facts are the headline numbers.
  glance: { text: string; bold?: boolean; link?: { label: string; href: string } }[];
  photos: string[];
  closing: { title: string; band: 'green' | 'orange' | 'yellow' };
}

const { room, seo, heading, lead, glance, photos, closing } = Astro.props;
---

<Layout title={seo.title} description={seo.description}>
  <PageHeader title={heading} current={room.name} lead={lead} crumbs={[{ label: 'Our rooms', href: '/rooms' }]}>
    <span slot="tape" class={`hs-tape hs-tape--${room.crayon}`}><span class="hs-tape__dab"></span>{room.ages}</span>
  </PageHeader>

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <h2 class="rv-visually-hidden">{room.name} at a glance</h2>
      <ul class="rv-glance">
        {glance.map((item) => (
          <li>
            {item.bold ? <b><Todo text={item.text} /></b> : <Todo text={item.text} />}
            {item.link && <> (<a href={item.link.href}>{item.link.label}</a>)</>}
          </li>
        ))}
      </ul>
      <ul class="hs-line rv-line-stack rv-photo-line">
        {photos.map((photo, index) => (
          <li><Photo caption={photo} crayon={index === 1 ? 'blue' : undefined} /></li>
        ))}
      </ul>
    </div>
  </section>

  <slot />

  <Closing title={closing.title} band={closing.band} />
</Layout>
