---
import PackList from '../../components/PackList.astro';
import RoomLeader from '../../components/RoomLeader.astro';
import RoomPage from '../../components/RoomPage.astro';
import Timetable from '../../components/Timetable.astro';
import rooms from '../../content/rooms.json';

const room = rooms[1];
---

<RoomPage
  room={room}
  seo={{
    title: 'Toddler Daycare Harris Park | Toddlers Room, Ages 2 to 3',
    description: 'Play-based toddler daycare in Harris Park for 2 to 3 year olds. 1 educator to 5 toddlers, garden time, halal meals cooked on site.',
  }}
  heading="Toddlers room: toddler daycare in Harris Park"
  lead="Busy hands, new words and growing independence. Our toddlers room has just 12 children aged 2 to 3, with educators your toddler knows."
  glance={[
    { text: 'Ages 2 to 3', bold: true },
    { text: '12 places', bold: true },
    { text: '1 educator to 5 toddlers', bold: true },
    { text: '$130 a day before subsidy', bold: true, link: { label: 'see fees', href: '/fees' } },
    { text: 'Room leader: [name]' },
  ]}
  photos={['The toddlers room at Rainbow Village', 'Building and stacking', 'Digging in the garden']}
  closing={{ title: 'See our toddlers room in person', band: 'orange' }}
>
  <Timetable
    title="A day in the toddlers room"
    items={[
      'Arrive and free play',
      'Morning tea',
      'Group time: songs, stories and counting',
      'Outdoor play and gardening',
      'Lunch, cooked here',
      'Rest',
      'Afternoon tea',
      'Play until home time',
    ]}
    note="Toilet learning happens at your child's pace, together with you."
  />

  <section class="hs-band hs-band--yellow" data-theme="kraft">
    <div class="hs-band__inner rv-stack-lg">
      <h2 class="hs-title">How toddlers learn through play</h2>
      <div class="rv-text-grid">
        <p>Toddlers learn through play, so we give them the freedom to choose. They pick resources, explore and follow what interests them, and our educators build on it.</p>
        <p>They practise doing things for themselves: washing hands, serving lunch, packing away and asking for help. Small jobs like these build big confidence.</p>
        <p>They learn to share, take turns and make first friendships. They sing and count in different languages, including Dharug, the local Aboriginal language. Parents often tell us how amazed they are by what their toddler comes home saying and doing.</p>
      </div>
    </div>
  </section>

  <RoomLeader
    title="Meet [name], our toddlers room leader"
    qualification="[Qualification]"
    quote="[A sentence in their own words.]"
    photo="Photo: toddlers room leader"
  />

  <PackList
    title="What to pack for your toddler"
    items={['Spare clothes (two sets)', 'A hat', 'A water bottle', 'A comforter for rest time, if used', 'Training pants, if toilet learning', 'Everything labelled']}
    provide="three meals, nappies and wipes, full cream milk and sunscreen."
    links="{← Babies room}(/rooms/babies) · {Next: Preschool, 3 to 6 →}(/rooms/preschool) · Questions? {Read our FAQs}(/faqs)"
  />
</RoomPage>
