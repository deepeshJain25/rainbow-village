---
import PageHeader from '../../components/PageHeader.astro';
import RoomCard from '../../components/RoomCard.astro';
import rooms from '../../content/rooms.json';
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Childcare Rooms in Harris Park | Babies, Toddlers, Preschool"
  description="Three age-based childcare rooms in Harris Park: babies from 6 weeks, toddlers 2 to 3 years and preschool 3 to 6 years. Small groups, vacancies on all days."
>
  <PageHeader
    compact
    title="Our childcare rooms"
    current="Our rooms"
    lead="Rainbow Village has three rooms, grouped by age, each with its own familiar educators. There are vacancies in every room on every day. [Confirm before launch.]"
    action={null}
  />

  <section class="hs-ground hs-paper-doodles rv-section rv-chalk rv-rooms-line" data-theme="chalkboard">
    <ul class="rv-wrap hs-line rv-line-stack">
      {rooms.map((room) => (
        <li>
          <RoomCard title={room.short} ages={room.shortAges} text={room.lineText} href={room.href} crayon={room.crayon as 'purple' | 'yellow' | 'orange'} />
        </li>
      ))}
    </ul>
  </section>

  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <div class="rv-copy">
        <h2 class="hs-title">Small rooms, familiar educators</h2>
        <p>With 40 places in total, our rooms stay small. Every child is known by name. Children keep the same educators day to day, so they settle faster and feel safe enough to explore.</p>
        <p>Every room has three meals a day cooked in our kitchen, time outdoors and in the garden, and songs and stories in many languages. You'll get daily photos and updates on the OWNA app. All rooms follow the Early Years Learning Framework.</p>
      </div>
      <div class="rv-panel rv-copy-panel">
        <div class="rv-copy">
          <h2>Which room is right for my child?</h2>
          <p>We place children by age and readiness, and talk it through with you on your tour. When your child is ready to move up, we plan the change with you and their educators. <mark class="rv-todo">[Confirm the transition process.]</mark></p>
          <p><a href="/faqs">Read our FAQs</a> · <a href="/fees">See daily fees</a></p>
        </div>
      </div>
    </div>
  </section>
</Layout>
