---
import PackList from '../../components/PackList.astro';
import RoomLeader from '../../components/RoomLeader.astro';
import RoomPage from '../../components/RoomPage.astro';
import Timetable from '../../components/Timetable.astro';
import Todo from '../../components/Todo.astro';
import rooms from '../../content/rooms.json';

const room = rooms[0];
const routines = [
  { title: 'Sleep.', text: 'Babies sleep when they need to, following the routine you use at home.' },
  { title: 'Feeding.', text: 'We follow your feeding plan. Nappies, wipes and full cream milk are included in your fee, and once your baby is on solids, meals are cooked fresh in our kitchen. [Confirm whether families supply formula and bottles.]' },
  { title: 'Updates.', text: "You'll get photos and notes through the OWNA app, so you know how they slept, ate and played." },
  { title: 'Settling in.', text: "We go at your baby's pace. Start with shorter days if that helps, and visit any time with our open-door policy. {Read about settling in}(/for-parents#settling)." },
];
---

<RoomPage
  room={room}
  seo={{
    title: 'Baby Daycare Harris Park | Babies Room, 6 Weeks to 2',
    description: 'Baby daycare in Harris Park from 6 weeks. 1 educator to 4 babies, your baby\'s own sleep and feeding routine, and daily photos on OWNA.',
  }}
  heading="Babies room: baby daycare in Harris Park"
  lead="Our babies room is a calm, small space for babies from 6 weeks to 2 years. Your baby follows their own routine, with the same caring educators every day and just 8 babies in the room."
  glance={[
    { text: 'Ages 6 weeks to 2 years', bold: true },
    { text: '8 places', bold: true },
    { text: '1 educator to 4 babies', bold: true },
    { text: '$135 a day before subsidy', bold: true, link: { label: 'see fees', href: '/fees' } },
    { text: 'Room leader: [name]' },
  ]}
  photos={['The babies room at Rainbow Village', 'Soft play and tummy time', 'Our sleep room [confirm]']}
  closing={{ title: 'See our babies room in person', band: 'green' }}
>
  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-panel rv-copy-panel">
      <div class="rv-copy">
        <h2>Infant care that follows your baby's routine</h2>
        {routines.map((item) => <p><b>{item.title}</b> <Todo text={item.text} /></p>)}
      </div>
    </div>
  </section>

  <Timetable
    title="A day in the babies room"
    lead="Babies' days are built around their own sleep and feeds. Between them there's sensory play, music and songs (often in home languages), story time, and time outdoors in the fresh air."
  />

  <section class="hs-band hs-band--purple" data-theme="kraft">
    <div class="hs-band__inner rv-stack-lg">
      <h2 class="hs-title">How babies learn and grow with us</h2>
      <div class="rv-text-grid">
        <p>In the first two years, learning happens through trust and touch. Our educators talk, sing and respond to every coo and gesture, which builds early language and confidence.</p>
        <p>Babies explore textures, sounds and movement, from tummy time to first steps. Each milestone is shared with you on OWNA.</p>
        <p>Most of all, your baby learns that this is a safe place with people they know. With continuity of care, the same educators are there each day. That bond is what makes everything else possible.</p>
      </div>
    </div>
  </section>

  <RoomLeader
    title="Meet [name], our babies room leader"
    qualification="[Qualification]"
    quote="[A sentence in their own words about caring for babies.]"
    photo="Photo: babies room leader"
  />

  <PackList
    title="What to pack for daycare"
    items={['Spare clothes (two full sets)', 'Comforter or dummy, if used', 'Bottles and formula or expressed milk [confirm]', 'A hat', "Everything labelled with your baby's name"]}
    provide="nappies, wipes, full cream milk, sunscreen and three meals once your baby is on solids."
    links="{Next: Toddlers room, 2 to 3 →}(/rooms/toddlers) · Questions? {Read our FAQs}(/faqs)"
  />
</RoomPage>
