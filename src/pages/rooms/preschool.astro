---
import PackList from '../../components/PackList.astro';
import RoomLeader from '../../components/RoomLeader.astro';
import RoomPage from '../../components/RoomPage.astro';
import Timetable from '../../components/Timetable.astro';
import rooms from '../../content/rooms.json';

const room = rooms[2];
---

<RoomPage
  room={room}
  seo={{
    title: 'Preschool Harris Park | School Readiness Program, 3 to 6',
    description: "Preschool in Harris Park led by a degree-qualified teacher with almost 20 years' experience. School readiness and NSW Start Strong fee relief.",
  }}
  heading="Preschool in Harris Park"
  lead="Our preschool program gets children aged 3 to 6 ready for big school. It's led by a degree-qualified early childhood teacher with almost 20 years' experience."
  glance={[
    { text: 'Ages 3 to 6', bold: true },
    { text: '20 places', bold: true },
    { text: '1 educator to 10 children', bold: true },
    { text: 'Degree-qualified early childhood teacher', bold: true },
    { text: 'NSW Start Strong funded', bold: true },
    { text: '$135 a day before subsidy', bold: true, link: { label: 'see fees', href: '/fees' } },
  ]}
  photos={['The preschool room at Rainbow Village', 'Our vegetable garden', 'Art on the wall']}
  closing={{ title: 'See our preschool in person', band: 'green' }}
>
  <Timetable
    title="A day in our preschool room"
    items={[
      'Arrive and choose an activity',
      'Morning group: news, stories and early literacy',
      'Morning tea',
      'Projects, maths games and outdoor play',
      'Lunch',
      'Rest or quiet activities',
      'Afternoon tea',
      'Garden, play and home time',
    ]}
  />

  <section class="hs-band hs-band--orange" data-theme="kraft">
    <div class="hs-band__inner rv-stack-lg">
      <h2 class="hs-title">A preschool program built on curiosity</h2>
      <div class="rv-text-grid">
        <p>Our preschoolers learn through play, projects and real experiences. They plant and care for vegetables in our garden, and they learn about recycling and caring for the environment through Parramatta Council incursions.</p>
        <p>They count and sing in their home languages and in Dharug, the local Aboriginal language. They learn how families from many cultures celebrate.</p>
        <p>Early literacy and numeracy are part of every day. They're woven into stories, games and conversations, not drilled.</p>
      </div>
    </div>
  </section>

  <section class="hs-sheet" data-theme="crayon">
    <div class="rv-wrap rv-sheet-body">
      <h2>School readiness: ready for big school</h2>
      <p>School readiness is about much more than letters and numbers. We give equal weight to independence, communication and getting along with others.</p>
      <p>Children learn to manage their own belongings, ask for help, say how they feel and sort out disagreements with friends. We also have links with nearby primary schools to help make the move a smooth one.</p>
      <p>Our goal is simple: children who leave Rainbow Village confident in themselves, comfortable with others and excited about learning.</p>
    </div>
  </section>

  <RoomLeader
    title="Meet [name], our early childhood teacher"
    qualification="Degree-qualified, with almost 20 years in early childhood education."
    quote="[A sentence in their own words about preschool.]"
    photo="Photo: our early childhood teacher"
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-copy">
      <h2 class="hs-title">NSW Start Strong preschool fee relief</h2>
      <p>We receive NSW Start Strong funding, which lowers fees for eligible children aged 3 and over, on top of the Child Care Subsidy. We apply it to your fees for you. <a href="/fees">See fees and subsidy</a>.</p>
    </div>
  </section>

  <PackList
    title="What to pack for preschool"
    items={['A bag your child can carry and open themselves', 'Spare clothes', 'A hat', 'A water bottle', 'Everything labelled']}
    provide="three home-style meals, full cream milk and sunscreen."
    links="{← Toddlers room}(/rooms/toddlers) · Questions? {Read our FAQs}(/faqs)"
  />
</RoomPage>
