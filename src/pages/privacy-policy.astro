---
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

const sections = [
  { id: 'who', title: 'Who we are' },
  { id: 'collect', title: 'What we collect through this website' },
  { id: 'use', title: 'How we use it' },
  { id: 'share', title: 'Who we share it with' },
  { id: 'cookies', title: 'Cookies and analytics' },
  { id: 'photos', title: 'Photos of children' },
  { id: 'access', title: 'How to access or correct your information' },
  { id: 'contact', title: 'Contact us' },
];
---

<Layout
  title="Privacy Policy | Rainbow Village Childcare Centre"
  description="How Rainbow Village Childcare Centre collects, uses and protects your personal information."
>
  <PageHeader title="Privacy policy" lead="Last updated [date]" action={null} />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-copy">
      <p><mark class="rv-todo">[Use the client's existing privacy policy if they have one. Otherwise this draft needs the client's review against the Australian Privacy Principles.]</mark></p>
      <nav aria-label="On this page">
        <ul class="rv-list">
          {sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
        </ul>
      </nav>

      <h2 id="who">Who we are</h2>
      <p>This website is run by {site.legalName}, ABN {site.abn}, at <Todo text={site.address} />.</p>

      <h2 id="collect">What we collect through this website</h2>
      <p>We collect the details you give us in our enquiry, waitlist and contact forms, and when you book a tour: your name, phone number and email, your child's date of birth, your preferred days and start date, and anything you write in a message.</p>

      <h2 id="use">How we use it</h2>
      <p>We use these details only to respond to your enquiry, arrange tours and manage our waitlist. Enrolment and medical details are kept in our secure childcare system, not on this website.</p>

      <h2 id="share">Who we share it with</h2>
      <p>We never sell or share your information for marketing. We use our email provider, booking provider and analytics to run this website. They handle your details only so we can reply to you, and some may store information outside Australia. <mark class="rv-todo">[List providers before launch: Resend, Cal.com, Cloudflare, Google.]</mark></p>

      <h2 id="cookies">Cookies and analytics</h2>
      <p>We use Google Analytics to understand how people use this website, such as which pages are visited and how many tours are booked. We use Cloudflare to protect the site and our forms from spam and attacks. These services may set cookies or process technical details such as your IP address and browser type.</p>

      <h2 id="photos">Photos of children</h2>
      <p>We publish photos of children only with written parental consent, and we remove them on request.</p>

      <h2 id="access">How to access or correct your information</h2>
      <p>You can ask to see, correct or delete your information at any time. We handle personal information in line with the Australian Privacy Principles.</p>

      <h2 id="contact">Contact us</h2>
      <p>Email <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={site.phoneHref}><Todo text={site.phone} /></a>. If you are not happy with our response, you can contact the <a href="https://www.oaic.gov.au/privacy/privacy-complaints" target="_blank" rel="noopener">Office of the Australian Information Commissioner (opens in a new tab)</a>.</p>
    </div>
  </section>
</Layout>
