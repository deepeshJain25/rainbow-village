---
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

const quickLinks = [
  { label: 'Parent app', href: '#app' },
  { label: 'Weekly menu', href: '/weekly-menu' },
  { label: 'Term dates', href: '#dates' },
  { label: 'Policies', href: '#policies' },
  { label: 'What to pack', href: '#pack' },
  { label: 'Fees', href: '/fees' },
];

const policies = [
  { topic: 'Health and safety', files: ['[Sun safety policy (PDF, size)]', '[Illness and medication policy (PDF, size)]'] },
  { topic: 'Food', files: ['[Nutrition and allergy policy (PDF, size)]'] },
  { topic: 'Families', files: ['[Parent handbook (PDF, size)]', '[Fees and payment policy (PDF, size)]'] },
];
---

<Layout
  title="Parent Information | Rainbow Village Childcare Harris Park"
  description="Everything current Rainbow Village families need: parent app sign-in, key dates, what to pack, sick-child guidelines and centre policies."
>
  <PageHeader
    title="For parents"
    lead="Everything you need, day to day, as a Rainbow Village family in Harris Park."
    crumbs={[{ label: 'Parents', href: '/for-parents' }]}
    action={null}
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg" id="app">
      <div><span class="hs-btn" aria-disabled="true">Open parent app</span></div>
      <p><Todo text="See photos and updates from your child's day in [parent app]. [Sign in, iPhone and Android links go here.]" /></p>
      <ul class="rv-tapes">
        {quickLinks.map((link) => <li><a class="hs-tape" href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="hs-sheet" data-theme="crayon">
    <div class="rv-wrap rv-sheet-body">
      <h2>Your first week</h2>
      <p><b>Orientation.</b> Short visits before your child starts, so the room and the educators feel familiar.</p>
      <p><b>Drop-off and pick-up.</b> <Todo text="We are open 7am to 6pm. [Sign-in steps and any cut-off times from the centre.]" /></p>
      <p id="pack"><b>What to pack on day one.</b> <Todo text="A spare change of clothes, a hat, [sheet and comforter for rest time] and [bottles and formula for babies], all labelled with your child's name." /></p>
      <p><b>Parent app.</b> <Todo text="We will set you up on [parent app] before your first day." /></p>
    </div>
  </section>

  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <div class="rv-copy">
        <h2 class="hs-title">If your child is unwell</h2>
        <p><Todo text="Please keep your child home if they have a fever, vomiting or diarrhoea, and [wait 24 hours after symptoms stop]. Call us by [8am] to let us know." /></p>
      </div>
      <div class="rv-copy" id="dates">
        <h2 class="hs-title">Key dates</h2>
        <p><Todo text="[Upcoming closure dates, such as the Christmas closure.]" /></p>
      </div>
      <div class="rv-copy" id="policies">
        <h2 class="hs-title">Policies</h2>
        {policies.map((group) => (
          <div class="rv-stack">
            <h3>{group.topic}</h3>
            <ul class="rv-list">{group.files.map((file) => <li><Todo text={file} /></li>)}</ul>
          </div>
        ))}
        <p><a href="/faqs">Read our FAQs</a></p>
      </div>
    </div>
  </section>

  <section class="hs-band hs-band--yellow" data-theme="kraft">
    <div class="hs-band__inner rv-closing">
      <div class="rv-stack">
        <h2 class="hs-title">Stay in touch</h2>
        <p><Todo text="Daily updates come through [parent app]. For anything about your child, talk to their room leader. For fees or enrolment, ask for [the director]." /></p>
      </div>
      <div class="rv-closing__actions">
        <span>Call <a href={site.phoneHref}>{site.phone}</a></span>
      </div>
    </div>
  </section>
</Layout>
