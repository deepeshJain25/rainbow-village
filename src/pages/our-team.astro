---
import Closing from '../components/Closing.astro';
import PageHeader from '../components/PageHeader.astro';
import Layout from '../layouts/Layout.astro';

interface Member {
  order: number;
  role: string;
  group: 'leadership' | 'educators';
  qualification?: string;
  years?: string;
  quote?: string;
  // Set for anyone who prefers no photo: their initials appear in crayon letters instead.
  initials?: string;
}

const team = Object.values(import.meta.glob<Member>('../content/team/*.json', { eager: true, import: 'default' }))
  .sort((a, b) => a.order - b.order);
const leadership = team.filter((member) => member.group === 'leadership');
const educators = team.filter((member) => member.group === 'educators');
---

<Layout
  title="Meet Our Educators | Rainbow Village Childcare Harris Park"
  description="Meet the director and educators who care for your child at Rainbow Village. Qualified, caring and part of a close-knit family team."
>
  <PageHeader
    title="Our team"
    lead="Meet the [X] educators behind Rainbow Village Childcare in Harris Park, with [X] years of combined experience. They are why families stay with us for years."
    crumbs={[{ label: 'About', href: '/about' }]}
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <h2 class="hs-title">The people leading each room</h2>
      <ul class="hs-line rv-team">
        {leadership.map((member) => (
          <li>
            <figure class="hs-painting rv-photo" data-theme="crayon">
              {member.initials
                ? <div class="rv-initials">{member.initials}</div>
                : <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>}
              <figcaption>
                <span class="hs-tape"><mark class="rv-todo">[Name]</mark></span>
                <p class="hs-painting__caption">{member.role}</p>
                <p class="hs-painting__caption"><mark class="rv-todo">{member.qualification}</mark> · <mark class="rv-todo">{member.years}</mark></p>
                <p class="rv-team-quote"><mark class="rv-todo">"{member.quote}"</mark></p>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <h2 class="hs-title">Our educators and cook</h2>
      <ul class="hs-line rv-team">
        {educators.map((member) => (
          <li>
            <figure class="hs-painting rv-photo" data-theme="crayon">
              {member.initials
                ? <div class="rv-initials">{member.initials}</div>
                : <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>}
              <figcaption>
                <span class="hs-tape"><mark class="rv-todo">[Name]</mark></span>
                <p class="hs-painting__caption">{member.role}</p>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-panel rv-copy-panel">
      <div class="rv-copy">
        <h2>How we look after your child</h2>
        <p>
          All our educators hold current <b>Working With Children Checks</b>, <b>first aid</b>, and
          <b>anaphylaxis and asthma training</b>. <mark class="rv-todo">[Confirm with the centre.]</mark>
        </p>
        <p>
          Each room has its own educators and ratio, so your child sees familiar faces every day.
          <mark class="rv-todo">[Add low staff turnover, if true.]</mark>
        </p>
        <p><a href="/rooms">See the ratio in each room</a></p>
      </div>
    </div>
  </section>

  <Closing title="Meet us in person" text="Tours take about 30 minutes, and you will meet the people who would care for your child." band="yellow" />
</Layout>
