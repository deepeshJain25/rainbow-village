---
import Field from '../components/Field.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

const steps = [
  { title: 'Visit us.', text: 'Book a tour on a Tuesday or Thursday, between 10am and 2pm.' },
  { title: 'Send your details.', text: 'Fill in the form below to join our list.' },
  { title: 'Get your offer.', text: "We'll call you to confirm your days and start date." },
  { title: 'Settle in.', text: "We plan your child's first days with you, at their pace." },
];
const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
---

<Layout
  title="Childcare Vacancies Harris Park | Enrol at Rainbow Village"
  description="Childcare vacancies in Harris Park in every room, every day. Join the waitlist for babies, toddlers or preschool at Rainbow Village."
>
  <PageHeader
    title="Enrol or join our childcare waitlist"
    current="Enrol and waitlist"
    lead="We have childcare vacancies in Harris Park in every room, on every day of the week. [Confirm before launch and keep it updated.]"
    crumbs={[{ label: 'Enrolment', href: '/fees' }]}
    action={{ label: 'Join the waitlist', href: '#waitlist' }}
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <h2 class="hs-title">How enrolment works</h2>
      <ol class="rv-steps">
        {steps.map((step) => (
          <li>
            <span class="rv-step">{step.title}</span>
            <span>{step.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="hs-band hs-band--sky" data-theme="kraft" id="waitlist">
    <div class="hs-band__inner rv-form-grid">
      <div class="rv-stack">
        <h2 class="hs-title">Join the waitlist</h2>
        <p>Prefer to talk? Call <a href={site.phoneHref}><Todo text={site.phone} /></a> or email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
      <!-- The success message is shown by the enquiry route once it is connected. -->
      <form
        class="hs-formsheet rv-form"
        data-theme="crayon"
        method="post"
        action="#"
        data-success="Thanks, [first name]. We've got your details and will be in touch within [2 business days, to confirm]."
      >
        <Field label="Your name" name="name" autocomplete="name" />
        <Field label="Phone" name="phone" type="tel" autocomplete="tel" />
        <Field label="Email" name="email" type="email" autocomplete="email" />
        <Field label="Child's date of birth" name="dob" type="date" />
        <Field label="Preferred start date" name="start" type="date" />
        <fieldset aria-describedby="days-help">
          <legend>Preferred days (Mon to Fri, choose at least 2)</legend>
          <div class="rv-days">
            {days.map((day) => <label><input type="checkbox" name="days" value={day} />{day}</label>)}
          </div>
          <p class="rv-form-note" id="days-help">Minimum 2 days a week. <a href="/fees">See daily fees</a>.</p>
        </fieldset>
        <Field label="Anything else we should know" name="message" optional rows={3} />
        <button class="hs-btn hs-btn--orange" type="submit">Join the waitlist</button>
        <p class="rv-form-note">We'll only use your details to contact you about enrolment.</p>
        <p class="rv-form-note"><mark class="rv-todo">[This form starts sending once the enquiry system is connected.]</mark></p>
      </form>
    </div>
  </section>
</Layout>
