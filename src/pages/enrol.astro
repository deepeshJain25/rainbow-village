---
import Field from '../components/Field.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

const steps = [
  { title: 'Tour', text: 'Book a tour to meet us and see the centre.' },
  { title: 'Waitlist', text: 'Join the waitlist with your preferred days and start date.' },
  { title: 'Offer', text: 'We offer you a place, send your enrolment pack and help you claim the Child Care Subsidy.' },
  { title: 'Orientation', text: 'Short visits, so your child starts feeling at home.' },
];
const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
---

<Layout
  title="Enrol at Rainbow Village Childcare | Join the Waitlist | Harris Park"
  description="Enrolling at Rainbow Village is simple. Join the waitlist online, book a tour, and we'll guide you through every step to your child's first day."
>
  <PageHeader
    title="Enrol or join the waitlist"
    lead="Enrolling at our Harris Park childcare centre takes four simple steps, and we guide you through each one."
    crumbs={[{ label: 'Enrolment', href: '/fees' }]}
    action={{ label: 'Join the waitlist', href: '#waitlist' }}
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <h2 class="hs-title">How enrolment works</h2>
      <ol class="rv-steps">
        {steps.map((step) => (
          <li>
            <span class="rv-step">{step.title}</span>
            <span>{step.text}</span>
          </li>
        ))}
      </ol>
      <p><mark class="rv-todo">[Current vacancies: Babies, Toddlers, Preschool]</mark></p>
    </div>
  </section>

  <section class="hs-band hs-band--sky" data-theme="kraft" id="waitlist">
    <div class="hs-band__inner rv-form-grid">
      <div class="rv-stack">
        <h2 class="hs-title">Join the waitlist</h2>
        <p>Tell us about your child, and we'll be in touch within <mark class="rv-todo">[1 business day]</mark>.</p>
        <p>Prefer to talk? Call <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <form class="hs-formsheet rv-form" data-theme="crayon" method="post" action="#">
        <Field label="Parent name" name="name" autocomplete="name" />
        <Field label="Phone" name="phone" type="tel" autocomplete="tel" />
        <Field label="Email" name="email" type="email" autocomplete="email" />
        <Field label="Child's date of birth" name="dob" type="date" />
        <Field label="Preferred start date" name="start" type="date" />
        <fieldset>
          <legend>Preferred days</legend>
          <div class="rv-days">
            {days.map((day) => <label><input type="checkbox" name="days" value={day} />{day}</label>)}
          </div>
        </fieldset>
        <Field label="Message" name="message" optional rows={3} />
        <button class="hs-btn hs-btn--orange" type="submit">Join the waitlist</button>
        <p class="rv-form-note"><mark class="rv-todo">[This form starts sending once the enquiry system is connected.]</mark></p>
      </form>
    </div>
  </section>
</Layout>
