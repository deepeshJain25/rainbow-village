---
import Closing from '../components/Closing.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import Todo from '../components/Todo.astro';
import menu from '../content/menu/week.json';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

// Checked at each rebuild: an old menu is replaced with a note, never shown as this week's food.
const isStale = menu.weekEnding ? new Date(menu.weekEnding) < new Date() : false;
---

<Layout
  title="Weekly Menu | Meals Cooked On Site | Rainbow Village Childcare"
  description="See this week's menu at Rainbow Village. Nutritious, home-style meals cooked fresh in our own kitchen, with allergies and dietary needs carefully managed."
>
  <PageHeader
    title="This week's menu"
    lead={`Childcare meals cooked fresh here every morning by ${menu.cook ?? "[cook's name]"}, in our own Harris Park kitchen.`}
  >
    <span slot="tape" class="hs-tape hs-tape--green"><span class="hs-tape__dab"></span>{menu.weekOf ?? <mark class="rv-todo">[Week of 9 to 13 November]</mark>}</span>
  </PageHeader>

  <section class="hs-sheet" data-theme="crayon">
    <div class="rv-wrap rv-sheet-body">
      <h2>Monday to Friday</h2>
      {isStale
        ? <p>This week's menu is on its way. Call us on <a href={site.phoneHref}>{site.phone}</a> for today's lunch.</p>
        : (
          <>
            <div class="rv-menu-table">
              <table class="rv-table">
                <thead>
                  <tr>
                    <td></td>
                    {menu.days.map((day) => <th scope="col">{day.day}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {menu.meals.map((meal, mealIndex) => (
                    <tr>
                      <th scope="row">{meal}</th>
                      {menu.days.map((day) => <td>{day.items[mealIndex] ?? <mark class="rv-todo">[Meal]</mark>}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="rv-menu-days">
              {menu.days.map((day, dayIndex) => (
                <details class="rv-details" open={dayIndex === 0}>
                  <summary>{day.day}<Icon name="chevron-down" /></summary>
                  <div class="rv-details__body">
                    {menu.meals.map((meal, mealIndex) => (
                      <p><b>{meal}:</b> {day.items[mealIndex] ?? <mark class="rv-todo">[Meal]</mark>}</p>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </>
        )}
      <p><Todo text="Vegetarian option: [written in words for each day]." /></p>
    </div>
  </section>

  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-stack rv-stack--wide">
      <p>Prefer it on the fridge?</p>
      <div><span class="hs-btn" aria-disabled="true">Download this week's menu (PDF)</span></div>
      <p><mark class="rv-todo">[The yellow stamp links to the PDF once the centre sends its menu.]</mark></p>
    </div>
  </section>

  <section class="hs-band hs-band--green" data-theme="kraft">
    <div class="hs-band__inner rv-stack-lg">
      <div class="rv-stack">
        <h2 class="hs-title">How we feed your child</h2>
        <p>Good food fuels good days, so every meal is made here.</p>
      </div>
      <div class="rv-text-grid">
        <p><b>Who cooks.</b> <Todo text="[Name] has been cooking for Rainbow Village children [for X years]. [One sentence on her approach.]" /></p>
        <p><b>How menus are planned.</b> <Todo text="We plan meals with lots of variety and flavours children actually eat, using [the dietitian or guideline used]." /></p>
        <p><b>Allergies and dietary needs.</b> <Todo text="We cater for allergies, intolerances and [halal, vegetarian and other] dietary needs. Tell us at enrolment and we will build a plan with you. [Allergy wording from the centre's policy.]" /></p>
        <p>"They have a kitchen that serves prepared nutritious food with lots of variety." Santosh, Rainbow Village parent</p>
      </div>
    </div>
  </section>

  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap">
      <ul class="hs-line rv-line-stack rv-photo-line">
        <li><Photo label="Photo: a real plate of lunch" crayon="red" /></li>
        <li><Photo label="Photo: our kitchen" /></li>
        <li><Photo label="Photo: children at the table, with consent" crayon="orange" /></li>
      </ul>
    </div>
  </section>

  <Closing title="Come and see what's cooking" text="Our kitchen is part of the tour." band="orange" />
</Layout>
