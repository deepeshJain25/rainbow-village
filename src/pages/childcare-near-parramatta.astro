---
import BrandText from '../components/BrandText.astro';
import Closing from '../components/Closing.astro';
import PageHeader from '../components/PageHeader.astro';
import RoomCard from '../components/RoomCard.astro';
import Todo from '../components/Todo.astro';
import reviews from '../content/reviews.json';
import rooms from '../content/rooms.json';
import { childCare } from '../content/schema';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

const suburbs = [
  {
    name: 'Childcare near Parramatta',
    text: 'Harris Park station is one stop from Parramatta on the T1 and T2 lines. Many families who work in Parramatta drop off on the way.',
  },
  {
    name: 'Childcare near Harris Park',
    text: 'Harris Park is right next door to Rosehill, so drop-off is quick whether you walk, drive or catch the train.',
  },
  {
    name: 'Childcare near Granville',
    text: 'Granville is one stop away on the other side of Harris Park station.',
  },
];

const reasons = [
  { title: 'Cozy and family-run.', text: "40 places, and an owner who greets you every morning. We're not a large chain. {Our story}(/about)." },
  { title: 'Food that suits local families.', text: 'Halal and vegetarian meals, cooked fresh on site, with no beef or pork.' },
  { title: 'Educators who speak your language.', text: 'English, Urdu, Punjabi, Hindi, Nepali and Telugu.' },
  { title: 'Part of the community since 2007.', text: "Parramatta Council incursions, links with local primary schools, and around 25 families who've returned with younger children." },
];
---

<Layout
  title="Childcare near Parramatta, Harris Park & Granville | Rosehill"
  description="Family-run childcare in Rosehill, one train stop from Parramatta and Granville. Cozy groups, halal meals, vacancies on all days."
  schema={childCare}
>
  <PageHeader
    title="Childcare near Parramatta, Harris Park and Granville"
    current="Childcare near Parramatta"
    lead="Rainbow Village is a family-run childcare centre in Rosehill, right between Parramatta, Harris Park and Granville. It's an easy drop-off on the way to work or the train."
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap">
      <div class="rv-copy">
        {suburbs.map((suburb) => (
          <div class="rv-stack">
            <h2 class="hs-title">{suburb.name}</h2>
            <p><Todo text={suburb.text} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hs-sheet" data-theme="crayon">
    <div class="rv-wrap rv-sheet-body">
      <h2><BrandText text="Why Parramatta families choose Rainbow Village" /></h2>
      {reasons.map((reason) => <p><b>{reason.title}</b> <Todo text={reason.text} /></p>)}
    </div>
  </section>

  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <ul class="hs-line rv-line-stack">
        {rooms.map((room) => (
          <li>
            <RoomCard title={room.short} ages={room.shortAges} href={room.href} crayon={room.crayon as 'purple' | 'yellow' | 'orange'} photo={room.photo} />
          </li>
        ))}
      </ul>
      <p>All rooms have vacancies.</p>
    </div>
  </section>

  <section class="hs-band hs-band--purple" data-theme="kraft">
    <div class="hs-band__inner rv-stack-lg">
      <div class="rv-stack">
        <h2 class="hs-title">Featured reviews</h2>
      </div>
      <div class="rv-text-grid">
        {reviews.slice(0, 2).map((review) => (
          <figure class="rv-review rv-review--static">
            <blockquote>"{review.quote}"</blockquote>
            <figcaption>{review.source}</figcaption>
          </figure>
        ))}
      </div>
      <p><Todo text={site.rating} /> · <a href={site.reviewsUrl}>Read all reviews on Google</a></p>
    </div>
  </section>

  <Closing title="Visit our Rosehill centre" band="green" secondary={{ label: 'Get directions', href: site.mapUrl }} />
</Layout>
