---
import Closing from '../components/Closing.astro';
import PageHeader from '../components/PageHeader.astro';
import RoomCard from '../components/RoomCard.astro';
import Todo from '../components/Todo.astro';
import reviews from '../content/reviews.json';
import rooms from '../content/rooms.json';
import { childCare } from '../content/schema';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

const suburbs = [
  {
    name: 'Childcare for Parramatta families',
    text: '[X minutes\' drive from Parramatta CBD, with the route.] We are a smaller, family-run alternative to the large centres in the city, with educators who know your child by name.',
  },
  {
    name: 'Childcare for Rosehill families',
    text: 'We are just next door in Harris Park, [X minutes away, with the route], and free street parking makes drop-offs easy.',
  },
  {
    name: 'Childcare for Granville families',
    text: '[X minutes\' drive, with the route.] Families make the trip for personal care, fresh meals cooked on site and a strong preschool program.',
  },
];

const reasons = [
  { title: 'Family-run, every day.', text: 'Our director is here every day and knows every child and family by name.' },
  { title: 'Places for 40 children.', text: 'Your child is never lost in the crowd.' },
  { title: 'Cooked fresh on site.', text: 'Our cook prepares meals in our own kitchen every day.' },
  { title: 'Rated Meeting the National Quality Standard.', text: 'Open 7am to 6pm for children from 6 months to 6 years.' },
];
---

<Layout
  title="Childcare near Parramatta, Rosehill and Granville | Rainbow Village"
  description="Looking for childcare near Parramatta, Rosehill or Granville? Rainbow Village in Harris Park is a short trip away: family-run, meals cooked on site, 4.8 stars."
  schema={childCare}
>
  <PageHeader
    title="Childcare near Parramatta, Rosehill and Granville"
    lead="Rainbow Village is a family-run childcare centre in the heart of Harris Park, a short trip from Parramatta, Rosehill and Granville."
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-split rv-leader">
      <div class="rv-copy">
        <h2 class="hs-title">Getting here</h2>
        {suburbs.map((suburb) => (
          <div class="rv-stack">
            <h3>{suburb.name}</h3>
            <p><Todo text={suburb.text} /></p>
          </div>
        ))}
        <p><b>Find us:</b> {site.address}. <a href={site.mapUrl}>Get directions</a></p>
      </div>
      <div class="rv-map" data-theme="crayon">
        <p><mark class="rv-todo">[Static map image showing the centre and the three suburbs]</mark></p>
      </div>
    </div>
  </section>

  <section class="hs-sheet" data-theme="crayon">
    <div class="rv-wrap rv-sheet-body">
      <h2>Why families from nearby choose us</h2>
      {reasons.map((reason) => <p><b>{reason.title}</b> {reason.text}</p>)}
    </div>
  </section>

  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <h2 class="hs-title">A room for every stage</h2>
      <ul class="hs-line rv-line-stack">
        {rooms.map((room) => (
          <li>
            <RoomCard title={room.name} ages={room.ages} text={room.text} href={room.href} crayon={room.crayon as 'purple' | 'yellow' | 'orange'} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hs-band hs-band--purple" data-theme="kraft">
    <div class="hs-band__inner rv-stack-lg">
      <div class="rv-stack">
        <h2 class="hs-title">Featured reviews</h2>
        <p>We have {site.rating} overall. <mark class="rv-todo">[Swap in reviews from families in these suburbs, if any mention it.]</mark></p>
      </div>
      <div class="rv-text-grid">
        {reviews.slice(0, 2).map((review) => (
          <figure class="rv-review rv-review--static">
            <blockquote>"{review.quote}"</blockquote>
            <figcaption>{review.source}</figcaption>
          </figure>
        ))}
      </div>
      <p><a href={site.reviewsUrl}>Read all reviews on Google</a></p>
    </div>
  </section>

  <Closing title="It's a short trip to come and see us" text="Tours take about 30 minutes." band="green" />
</Layout>
