---
import Closing from '../components/Closing.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import Layout from '../layouts/Layout.astro';

// Photos not used elsewhere on the site, by filter. A filter only shows once it has photos (no food photos yet).
const photos = [
  { cat: 'rooms', photo: 'toddlers-our-family-wall', caption: 'The "Our Family" wall in the toddlers room', crayon: 'purple' },
  { cat: 'garden', photo: 'outdoor-playhouse-slide', caption: 'Slides and a playhouse in our outdoor play area', crayon: 'blue' },
  { cat: 'art', photo: 'toddlers-tea-party', caption: 'A tea party set for pretend play', crayon: 'red' },
  { cat: 'rooms', photo: 'babies-cots', caption: 'Cots by the window in the babies sleep room', crayon: 'orange' },
  { cat: 'art', photo: 'toddlers-art-door', caption: "Children's tree paintings by the toddlers room door", crayon: 'purple' },
  { cat: 'garden', photo: 'outdoor-climbing-frame', caption: 'Climbing frames and balance beams outside', crayon: 'blue' },
  { cat: 'rooms', photo: 'toddlers-soft-toys', caption: 'Soft toys lined up under the toddlers room windows', crayon: 'red' },
  { cat: 'art', photo: 'babies-puppets', caption: 'Puppets and books on the soft mat in the babies room', crayon: 'orange' },
  { cat: 'rooms', photo: 'preschool-tables', caption: 'A preschool table set for the day', crayon: 'purple' },
  { cat: 'garden', photo: 'outdoor-cubby', caption: 'A cubby house in the outdoor play area', crayon: 'blue' },
  { cat: 'art', photo: 'babies-play-kitchen', caption: 'A play kitchen and washing machine in the babies room', crayon: 'red' },
  { cat: 'rooms', photo: 'toddlers-sunflower-corner', caption: 'Toys and a big sunflower by the toddlers room window', crayon: 'orange' },
  { cat: 'art', photo: 'rainbow-wall', caption: 'Our rainbow wall', crayon: 'purple' },
  { cat: 'rooms', photo: 'toddlers-tv-corner', caption: 'Toy shelves in the toddlers room', crayon: 'blue' },
  { cat: 'art', photo: 'babies-rug', caption: 'A bird and crocodile rug in the babies room', crayon: 'red' },
  { cat: 'rooms', photo: 'entrance-street-library', caption: 'Our little street library at the front gate', crayon: 'orange' },
] as const;

const allFilters = [
  { id: 'all', label: 'All' },
  { id: 'rooms', label: 'Rooms' },
  { id: 'garden', label: 'Outdoor play' },
  { id: 'food', label: 'Food' },
  { id: 'art', label: 'Art and play' },
];
const filters = allFilters.filter((filter) => filter.id === 'all' || photos.some((photo) => photo.cat === filter.id));
---

<Layout
  title="Photos of Rainbow Village Childcare Centre, Rosehill"
  description="See inside our Rosehill childcare centre: the babies, toddlers and preschool rooms, our vegetable garden and our kitchen. Real photos."
>
  <PageHeader
    title="Inside our Rosehill childcare centre"
    current="Gallery"
    lead="Our rooms, our garden and our kitchen. Every photo here was taken at Rainbow Village."
    crumbs={[{ label: 'About', href: '/about' }]}
  />

  <section class="hs-ground hs-paper-doodles rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-gallery">
      <p class="rv-gallery__intro">Rainbow Village is a cozy child care centre with three rooms: babies, toddlers and preschool. Each is set up so children can choose what to play with and explore at their own pace. Outside, children dig, plant and pick vegetables in our garden. Inside, our kitchen cooks three home-style meals every day.</p>
      {filters.map((filter, index) => (
        <input class="rv-filter" type="radio" name="gallery-filter" id={`g-${filter.id}`} checked={index === 0} aria-label={`Show ${filter.label}`} />
      ))}
      <div class="rv-tapes rv-filter-tapes" aria-hidden="true">
        {filters.map((filter) => <label class="hs-tape" for={`g-${filter.id}`}>{filter.label}</label>)}
      </div>
      <div class="rv-wall">
        {photos.map((photo) => (
          <div data-cat={photo.cat}><Photo caption={photo.caption} photo={photo.photo} crayon={photo.crayon} sizes="(max-width: 860px) 90vw, 360px" /></div>
        ))}
      </div>
    </div>
  </section>

  <Closing title="It looks even better in person" band="orange" />
</Layout>
