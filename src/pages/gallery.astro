---
import Closing from '../components/Closing.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import Layout from '../layouts/Layout.astro';

const filters = [
  { id: 'all', label: 'All' },
  { id: 'rooms', label: 'Rooms' },
  { id: 'garden', label: 'Garden' },
  { id: 'food', label: 'Food' },
  { id: 'art', label: 'Art and play' },
];

// Example captions, to match the final photos.
const photos = [
  { cat: 'rooms', caption: 'The babies room, set up for tummy time and gentle play', crayon: 'purple' },
  { cat: 'art', caption: 'Toddlers building, stacking and exploring', crayon: 'blue' },
  { cat: 'garden', caption: 'Our vegetable garden, planted and cared for by the children', crayon: 'red' },
  { cat: 'food', caption: 'Lunch, cooked fresh in our kitchen', crayon: 'orange' },
  { cat: 'art', caption: 'Paintings and drawings from the preschool room', crayon: 'purple' },
  { cat: 'art', caption: 'Counting and singing in different languages at group time', crayon: 'blue' },
] as const;
---

<Layout
  title="Photos of Rainbow Village Childcare Centre, Harris Park"
  description="See inside our Harris Park childcare centre: the babies, toddlers and preschool rooms, our vegetable garden and our kitchen. Real photos."
>
  <PageHeader
    title="Inside our Harris Park childcare centre"
    current="Gallery"
    lead="Our rooms, our garden and our kitchen. Every photo here was taken at Rainbow Village."
    crumbs={[{ label: 'About', href: '/about' }]}
  />

  <section class="hs-ground hs-paper-doodles rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-gallery">
      <p class="rv-gallery__intro">Rainbow Village is a small child care centre with three rooms: babies, toddlers and preschool. Each is set up so children can choose what to play with and explore at their own pace. Outside, children dig, plant and pick vegetables in our garden. Inside, our kitchen cooks three home-style meals every day.</p>
      {filters.map((filter, index) => (
        <input class="rv-filter" type="radio" name="gallery-filter" id={`g-${filter.id}`} checked={index === 0} aria-label={`Show ${filter.label}`} />
      ))}
      <div class="rv-tapes rv-filter-tapes" aria-hidden="true">
        {filters.map((filter) => <label class="hs-tape" for={`g-${filter.id}`}>{filter.label}</label>)}
      </div>
      <div class="rv-wall">
        {photos.map((photo) => (
          <div data-cat={photo.cat}><Photo caption={photo.caption} crayon={photo.crayon} /></div>
        ))}
      </div>
    </div>
  </section>

  <Closing title="It looks even better in person" band="orange" />
</Layout>
