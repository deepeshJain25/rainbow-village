---
import Closing from '../components/Closing.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import rooms from '../content/rooms.json';
import Layout from '../layouts/Layout.astro';

const estimatorUrl = 'https://www.servicesaustralia.gov.au/how-much-child-care-subsidy-you-can-get';

const steps = [
  { title: "Check if you're eligible.", text: 'Apply for the Child Care Subsidy through your myGov account linked to Centrelink.' },
  { title: 'Give us your details.', text: "Once approved, give us your and your child's CRNs, and we confirm your enrolment." },
  { title: 'Pay only the gap.', text: 'The government pays your subsidy straight to us, and you pay the difference. The subsidy can cover up to 90% of the fee, depending on your family income.' },
];

const questions = [
  { q: 'Do I pay for public holidays?', a: "We're closed on NSW public holidays. [Confirm whether fees are charged.]" },
  { q: 'Do I pay when my child is sick or away?', a: '[Confirm the absence policy.] The subsidy covers a set number of absence days each year.' },
  { q: 'How do I pay?', a: '[Confirm the method, for example direct debit through OWNA.]' },
  { q: 'Is the bond refundable?', a: "Yes. It's refunded when you give one month's notice." },
];
---

<Layout
  title="Childcare Fees Harris Park | Child Care Subsidy (CCS)"
  description="Childcare fees in Harris Park from $130 a day, with 3 meals, nappies and sunscreen included. CCS approved, plus NSW Start Strong fee relief."
>
  <PageHeader
    title="Childcare fees and the Child Care Subsidy"
    current="Fees and subsidy"
    lead="Our childcare fees in Harris Park are clear, with meals, nappies and more included. We're approved for the Child Care Subsidy, so most families pay much less than the daily fee. [Confirm the CCS-approved wording.]"
    crumbs={[{ label: 'Enrolment', href: '/enrol' }]}
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <h2 class="hs-title">Our daily fees</h2>
      <div class="rv-table-wrap">
        <table class="rv-table">
          <thead>
            <tr><th scope="col">Room</th><th scope="col">Ages</th><th scope="col">Daily fee (before subsidy)</th></tr>
          </thead>
          <tbody>
            {rooms.map((room) => (
              <tr>
                <th scope="row"><a href={room.href}>{room.short}</a></th>
                <td>{room.shortAges}</td>
                <td><b>{room.fee}</b></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="rv-copy">
        <p><b>Included in every fee:</b> three meals cooked on site, nappies and wipes, full cream milk, sunscreen and incursions.</p>
        <p><b>Enrolment:</b> a minimum of 2 days a week. There's a one-week bond, refunded when you give one month's notice, and a $50 admin fee (non-refundable).</p>
      </div>
    </div>
  </section>

  <section class="hs-sheet" data-theme="crayon">
    <div class="rv-wrap rv-sheet-body">
      <h2>How the Child Care Subsidy (CCS) works</h2>
      <ol class="rv-numbered">
        {steps.map((step) => <li><b>{step.title}</b> {step.text}</li>)}
      </ol>
      <p><b>3 Day Guarantee:</b> since 5 January 2026, most families get at least 72 hours of subsidised care per fortnight (about 3 days a week).</p>
      <p>
        <a href={estimatorUrl} target="_blank" rel="noopener">Estimate your subsidy on the Services Australia website (opens in a new tab)</a>
      </p>
    </div>
  </section>

  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <div class="rv-panel rv-copy-panel">
        <div class="rv-copy">
          <h2>NSW Start Strong fee relief for 3 to 5 year olds</h2>
          <p>Rainbow Village receives NSW Start Strong funding. Eligible children aged 3 and over get extra fee relief from the NSW Government, applied after your Child Care Subsidy. The amount depends on your child's age, and we take it off your fees for you. You just complete a short declaration form with us. <a href="/rooms/preschool">Learn about our preschool program</a>.</p>
        </div>
      </div>

      <p><b>A worked example:</b> <mark class="rv-todo">[Optional. Add it only after the client approves it and we check it against current CCS rates.]</mark></p>

      <div class="rv-details-list">
        <h2 class="hs-title">Childcare fee questions</h2>
        {questions.map((item) => (
          <details class="rv-details">
            <summary>{item.q}<Icon name="chevron-down" /></summary>
            <div class="rv-details__body"><p><Todo text={item.a} /></p></div>
          </details>
        ))}
        <p class="rv-details-more"><b>More questions?</b> <a href="/faqs">Read all FAQs</a></p>
      </div>
    </div>
  </section>

  <Closing title="Questions about fees? Ask us on your tour" band="green" secondary={{ label: 'Join the waitlist', href: '/enrol' }} />
</Layout>
