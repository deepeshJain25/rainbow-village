---
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import rooms from '../content/rooms.json';
import Layout from '../layouts/Layout.astro';

const estimatorUrl = 'https://www.servicesaustralia.gov.au/how-much-child-care-subsidy-you-can-get';

const questions = [
  { q: 'Do I pay when my child is away?', a: '[Confirm the centre\'s absence fee rule.] The Child Care Subsidy can cover up to 42 absence days per child each financial year.' },
  { q: 'Do I pay on public holidays?', a: '[Confirm the centre\'s public holiday fee rule.]' },
  { q: 'Is there a bond or enrolment fee?', a: '[Confirm whether the centre charges a bond or enrolment fee, and how much.]' },
  { q: 'How does payment work?', a: '[Confirm how and when families pay, such as direct debit each fortnight.]' },
];
---

<Layout
  title="Childcare Fees Harris Park | Child Care Subsidy | Rainbow Village"
  description="Clear daily fees for every room at Rainbow Village, with meals and more included. See how the Child Care Subsidy reduces what you pay."
>
  <PageHeader
    title="Fees and Child Care Subsidy"
    lead="Clear childcare fees in Harris Park. We're CCS approved, so most families pay much less than the daily fee."
    crumbs={[{ label: 'Enrolment', href: '/enrol' }]}
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <h2 class="hs-title">Daily fees</h2>
      <p>One daily fee per room, for hours between 7am and 6pm, Monday to Friday.</p>
      <div class="rv-table-wrap">
        <table class="rv-table">
          <thead>
            <tr><th scope="col">Room</th><th scope="col">Ages</th><th scope="col">Fee per day</th></tr>
          </thead>
          <tbody>
            {rooms.map((room) => (
              <tr>
                <th scope="row"><a href={room.href}>{room.name}</a></th>
                <td>{room.ages}</td>
                <td><b><mark class="rv-todo">[fee per day]</mark></b></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="rv-copy">
        <h3>Included in every day</h3>
        <ul class="rv-list">
          <li><Todo text="[Breakfast,] lunch and snacks cooked on site" /></li>
          <li><Todo text="[Nappies and wipes]" /></li>
          <li><Todo text="[Sunscreen and hats]" /></li>
          <li><Todo text="[Incursions and excursions]" /></li>
        </ul>
        <p><mark class="rv-todo">[Rated Meeting the National Quality Standard. Child Care Subsidy approved: wording from the centre.]</mark></p>
      </div>
    </div>
  </section>

  <section class="hs-sheet" data-theme="crayon">
    <div class="rv-wrap rv-sheet-body">
      <h2>How the Child Care Subsidy works</h2>
      <p>The Australian Government pays part of your fee straight to us, so you only pay the gap. The amount depends on your family income. Since January 2026, eligible families receive at least 3 days of subsidised care a week.</p>
      <ol class="rv-numbered">
        <li><b>Check you are eligible.</b> Apply through your Centrelink online account in myGov.</li>
        <li><b>Give us your details.</b> Share your CRN and your child's CRN and date of birth when you enrol.</li>
        <li><b>The subsidy comes off your fee.</b> We apply it to each invoice, and you pay the rest.</li>
      </ol>
      <p>
        <a href={estimatorUrl} target="_blank" rel="noopener">Estimate your subsidy on the Services Australia website (opens in a new tab)</a>
      </p>
    </div>
  </section>

  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <div class="rv-panel rv-copy-panel">
        <div class="rv-copy">
          <h2>A worked example (example only)</h2>
          <p><mark class="rv-todo">[The centre approves these numbers, and we check them against current subsidy rates before launch.]</mark></p>
          <ol class="rv-numbered">
            <li>A family uses <Todo text="[X]" /> days a week in the Toddlers room, at <Todo text="[fee per day]" /> a day.</li>
            <li>Their weekly fee is <Todo text="[$X]" />.</li>
            <li>Their subsidy percentage is <Todo text="[X%]" />, which takes <Todo text="[$X]" /> off the fee, up to the government's hourly cap.</li>
            <li>They pay a gap of <Todo text="[$X]" /> a week.</li>
          </ol>
        </div>
      </div>

      <div class="rv-details-list">
        <h2 class="hs-title">Fee questions</h2>
        {questions.map((item) => (
          <details class="rv-details">
            <summary>{item.q}<Icon name="chevron-down" /></summary>
            <div class="rv-details__body"><p><Todo text={item.a} /></p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="hs-band hs-band--green" data-theme="kraft">
    <div class="hs-band__inner rv-closing">
      <div class="rv-stack">
        <h2 class="hs-title">Questions about fees?</h2>
        <p>Ask us on your tour, and we'll talk you through what you would pay.</p>
      </div>
      <div class="rv-closing__actions">
        <a class="hs-btn hs-btn--orange" href="/book-a-tour">Book a tour</a>
        <a class="hs-btn hs-btn--yellow" href="/enrol">Join the waitlist</a>
      </div>
    </div>
  </section>
</Layout>
