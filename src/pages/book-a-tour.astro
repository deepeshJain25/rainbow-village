---
import Field from '../components/Field.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

// tours start on the half hour from 10am, with the last one starting at 1:30pm so it ends by 2pm
const times = ['10:00am', '10:30am', '11:00am', '11:30am', '12:00pm', '12:30pm', '1:00pm', '1:30pm'];
// the next Tuesday and Thursday after today; src/scripts/forms.ts fills in their dates in the visitor's browser
const tourDays = [{ name: 'Tuesday', weekday: 2 }, { name: 'Thursday', weekday: 4 }];
---

<script>
  import '../scripts/forms';
</script>

<Layout
  title="Book a Childcare Tour in Rosehill | Rainbow Village"
  description="Visit our Rosehill childcare centre. Tours run Tuesday and Thursday, 10am to 2pm. See the rooms, garden and kitchen. Book online in a minute."
>
  <PageHeader
    compact
    title="Book a childcare tour in Rosehill"
    current="Book a tour"
    lead="Tours run Tuesday and Thursday, 10am to 2pm, and take about 30 minutes. Bring your child if you like. [Confirm the tour length.]"
    crumbs={[{ label: 'Enrolment', href: '/fees' }]}
    action={null}
  />

  <div class="rv-page-split rv-page-split--band-first">
    <div class="hs-ground rv-page-split__copy" data-theme="crayon">
      <h2 class="hs-title">What you'll see on your tour</h2>
      <ul class="rv-list">
        <li>All three rooms (babies, toddlers and preschool) and the educators who would care for your child</li>
        <li>Our vegetable garden and outdoor play areas</li>
        <li>Our kitchen, and lunch being served</li>
        <li>Time to ask about fees and the Child Care Subsidy and settling in</li>
      </ul>
      <p><b>Address:</b> <Todo text={site.address} /> · <a href={site.mapUrl}>Get directions</a></p>
      <p><b>Parking:</b> <mark class="rv-todo">[parking note]</mark></p>
    </div>
    <div class="hs-band hs-band--sky rv-page-split__band" data-theme="kraft">
      <!-- Requests go to the centre's inbox through Web3Forms (site.formKey); src/scripts/forms.ts sends them. -->
      <form
        class="hs-formsheet rv-form rv-form--compact"
        data-theme="crayon"
        method="post"
        action="https://api.web3forms.com/submit"
        data-form
        data-subject="Tour request from the website"
        data-success="Thanks! We've got your tour request and will call or email you to confirm a time."
      >
        <h2 class="rv-form__full">Request a tour</h2>
        <input type="hidden" name="access_key" value={site.formKey} />
        <input class="rv-visually-hidden" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="rv-form__full"><Field label="Your name" name="name" autocomplete="name" mark="*" /></div>
        <Field label="Phone" name="phone" type="tel" autocomplete="tel" mark="**" contact />
        <Field label="Email" name="email" type="email" autocomplete="email" mark="**" contact />
        <div class="rv-form__full"><Field label="Child's date of birth" name="dob" type="date" optional /></div>
        <fieldset class="rv-form__full">
          <legend>Tour day<span class="rv-mark" aria-hidden="true"> *</span></legend>
          <div class="rv-choices">
            {tourDays.map((day, index) => (
              <label class="rv-choice" data-tour-day={day.weekday}>
                <input type="radio" name="date" value={`Next ${day.name}`} required={index === 0} />
                <span><b>{day.name}</b> <span data-tour-date>next week</span></span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="rv-form__full">
          <legend>Time<span class="rv-mark" aria-hidden="true"> *</span></legend>
          <div class="rv-choices rv-choices--times">
            {times.map((time, index) => (
              <label class="rv-choice">
                <input type="radio" name="time" value={time} required={index === 0} />
                <span>{time}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="rv-form__full"><Field label="Anything you'd like us to know" name="message" optional rows={3} /></div>
        <button class="hs-btn hs-btn--orange rv-form__full" type="submit">Request a tour</button>
        <p class="rv-form-note rv-form__full" id="contact-help"><span class="rv-mark" aria-hidden="true">*</span> Required. <span class="rv-mark" aria-hidden="true">**</span> One of phone or email is needed so we can contact you. You can give both.</p>
        <p class="rv-form-note rv-form__full" data-form-status role="status" aria-live="polite"></p>
        <p class="rv-form-note rv-form__full">
          We'll confirm your time by phone or email. Prefer to talk? Call <a href={site.phoneHref}><Todo text={site.phone} /></a> or email <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
        {!site.formKey && <p class="rv-form-note rv-form__full"><mark class="rv-todo">[This form starts sending once the centre's Web3Forms access key is added.]</mark></p>}
      </form>
    </div>
  </div>
</Layout>
