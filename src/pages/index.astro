---
import Closing from '../components/Closing.astro';
import Icon from '../components/Icon.astro';
import ReviewsSlider from '../components/ReviewsSlider.tsx';
import RoomCard from '../components/RoomCard.astro';
import Todo from '../components/Todo.astro';
import reviews from '../content/reviews.json';
import rooms from '../content/rooms.json';
import { childCare } from '../content/schema';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

const reasons = [
  {
    title: 'Family-run, every day.',
    text: "Our owner, Nighat, or her daughter is here each morning to greet you. There's always someone who knows your child by name and is there to talk. {Read our story}(/about).",
  },
  {
    title: 'Small groups, familiar faces.',
    text: 'We have just 40 places across three rooms. Your child stays with the same educators, so trust builds quickly and lasts. Our ratios are 1 educator to 4 babies, 1 to 5 toddlers and 1 to 10 preschoolers.',
  },
  {
    title: 'Families come back.',
    text: 'About 25 families have returned to us with their second or third child. Some of our educators stayed more than 10 years. We think that says more than we could.',
  },
  {
    title: 'Your culture belongs here.',
    text: 'Our educators speak English, Urdu, Punjabi, Hindi, Nepali and Telugu. Children sing and count in their home languages, and in Dharug, the local Aboriginal language. {Meet our team}(/our-team).',
  },
];

// Times are still to confirm with the centre.
const day = [
  'Arrive, settle and free play',
  'Morning tea',
  'Group time: stories, songs and counting in different languages',
  'Garden and outdoor play',
  'Lunch, cooked here',
  'Rest and quiet time',
  'Afternoon tea',
  'Play and home time',
];

const educators = [
  { role: 'Director', crayon: 'green' },
  { role: 'Room leader', crayon: 'blue' },
  { role: 'Room leader', crayon: 'red' },
];
---

<Layout
  title="Childcare Harris Park | Rainbow Village Childcare Centre"
  description="Family-run childcare centre in Harris Park since 2007. Babies from 6 weeks, toddlers and preschool. Halal meals cooked on site. Book a tour."
  schema={childCare}
>
  <!-- Hero: bright green, the page's one big colour moment. The rating is live from the Places API once that is set up. -->
  <section class="hs-band hs-band--sky hs-band--flat-top hs-hero" data-theme="crayon">
    <div class="hs-hero__grid">
      <div class="hs-hero__words">
        <div class="rv-stack">
          <h1 class="rv-hero-eyebrow">Family-run childcare in Harris Park</h1>
          <p class="hs-hero__title rv-hero-title"><span>A second home</span> <span>for your child</span></p>
        </div>
        <p class="hs-hero__lead">Rainbow Village is a small, family-run child care centre in Harris Park, caring for children from 6 weeks to 6 years since 2007. You'll find familiar educators, small groups and home-style meals cooked here every day.</p>
        <div class="hs-hero__actions rv-hero-actions">
          <a class="hs-btn hs-btn--orange" href="/book-a-tour">Book a tour</a>
          <a class="hs-btn hs-btn--yellow" href={site.phoneHref}>Call <Todo text={site.phone} /></a>
        </div>
        <ul class="rv-trust">
          <li><span class="rv-star"><Icon name="star" /></span><Todo text={site.rating} /></li>
          <li><Icon name="house" />Family-run since 2007</li>
          <li><Icon name="clock" />Open <Todo text={site.hours} /></li>
        </ul>
      </div>
      <div class="hs-hero__line">
        <ul class="hs-line rv-hero-paintings">
          {rooms.map((room) => (
            <li>
              <a class:list={['hs-painting', room.crayon !== 'yellow' && `hs-painting--${room.crayon}`]} data-theme="crayon" href={room.href}>
                <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>
                <p class="hs-painting__title">{room.short}</p>
                <p class="hs-painting__caption">{room.shortAges}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="hs-hero__land" aria-hidden="true"><i></i><i></i><i></i></div>
  </section>

  <!-- Why families choose us: four reasons and one taped photo, no icon grid -->
  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-split">
      <div class="rv-stack-lg">
        <h2 class="hs-title">Why families choose Rainbow Village Childcare</h2>
        <p>Rainbow Village isn't just childcare. It's a place where children are known, families feel welcome, and every child gets the time and attention to flourish.</p>
        {reasons.map((reason) => <p><b>{reason.title}</b> <Todo text={reason.text} /></p>)}
      </div>
      <figure class="hs-painting hs-painting--blue rv-taped" data-theme="crayon">
        <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>
        <figcaption class="hs-painting__caption"><mark class="rv-todo">[Photo of the centre]</mark></figcaption>
      </figure>
    </div>
  </section>

  <!-- Our rooms: the main path deeper into the site -->
  <section class="hs-band hs-band--sky" data-theme="kraft">
    <div class="hs-band__inner">
      <div class="rv-stack">
        <h2 class="hs-title">Childcare rooms for every age, from 6 weeks to 6 years</h2>
        <p>Three rooms, grouped by age, each with its own educators. There are vacancies in every room on every day.</p>
      </div>
      <ul class="hs-line rv-line-stack">
        {rooms.map((room) => (
          <li>
            <RoomCard title={room.short} ages={room.shortAges} text={room.homeText} href={room.href} crayon={room.crayon as 'purple' | 'yellow' | 'orange'} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- A day here: the timetable sits on the ruled lines -->
  <section class="hs-sheet" data-theme="crayon">
    <div class="rv-wrap rv-sheet-body">
      <h2>A day at our Harris Park centre</h2>
      <p>Every day mixes play, learning, fresh air and good food, at a pace that suits your child.</p>
      <dl class="rv-day">
        {day.map((activity) => (
          <div>
            <dt><mark class="rv-todo">[time]</mark></dt>
            <dd>{activity}</dd>
          </div>
        ))}
      </dl>
      <p>All meals are cooked fresh in our own kitchen. They're halal, vegetarian-friendly and nut-aware. <a href="/meals">See our meals</a>.</p>
    </div>
  </section>

  <!-- Featured reviews: label, overall rating and a link to all of them (ACCC guidance) -->
  <section class="hs-band hs-band--purple" data-theme="kraft">
    <div class="hs-band__inner rv-stack-lg">
      <div class="rv-stack">
        <h2 class="hs-title">What Harris Park families say</h2>
        <p>Featured reviews</p>
      </div>
      <ReviewsSlider client:visible reviews={reviews} />
      <p><Todo text={site.rating} /> · <a href={site.reviewsUrl}>Read all reviews on Google</a></p>
    </div>
  </section>

  <!-- See inside: the video, then the people. Portraits fall back to initials if a staff member prefers. -->
  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <div class="rv-stack">
        <h2 class="hs-title">Take a look inside Rainbow Village</h2>
        <p>Ninety seconds in our rooms and garden, and the people your child will spend their day with.</p>
      </div>
      <div class="rv-split rv-inside">
        <ul class="hs-line rv-line-single">
          <li>
            <figure class="hs-painting rv-poster">
              <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>
              <figcaption class="hs-painting__caption">A morning at Rainbow Village Childcare, Harris Park</figcaption>
            </figure>
          </li>
        </ul>
        <div class="rv-stack-lg">
          <p>Meet our educators: qualified, caring and here for the long term. <a href="/our-team">Meet our team</a></p>
          <ul class="hs-line rv-line-stack rv-line-stack--straight rv-portraits">
            {educators.map((educator) => (
              <li>
                <a class={`hs-painting hs-painting--${educator.crayon}`} href="/our-team" aria-label={`Meet our team: ${educator.role}`}>
                  <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>
                  <span class="hs-tape"><mark class="rv-todo">[Name]</mark></span>
                  <p class="hs-painting__caption">{educator.role}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Fees teaser: one line above the closing band -->
  <section class="hs-ground rv-section rv-fees-teaser" data-theme="crayon">
    <p class="rv-wrap">Daily fees from $130, with three meals, nappies and sunscreen included. We're approved for the Child Care Subsidy. <a href="/fees">See fees and subsidy</a></p>
  </section>

  <Closing title="Visit our Harris Park childcare centre" text="Tours run Tuesday and Thursday, 10am to 2pm. Bring your child if you like." band="green" />
</Layout>
