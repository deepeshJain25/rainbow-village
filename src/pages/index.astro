---
import Closing from '../components/Closing.astro';
import ReviewsSlider from '../components/ReviewsSlider.tsx';
import RoomCard from '../components/RoomCard.astro';
import reviews from '../content/reviews.json';
import rooms from '../content/rooms.json';
import { childCare } from '../content/schema';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

const reasons = [
  {
    title: 'Family-run, every day.',
    text: 'We are a family-run, women-owned centre. Our director is here every day and knows every child and family by name.',
  },
  {
    title: 'Places for 40 children.',
    text: 'Your child is never lost in the crowd, and educators have time for every child.',
  },
  {
    title: 'Cooked fresh on site.',
    text: 'Our cook prepares nutritious meals in our own kitchen every day, with plenty of variety children actually enjoy.',
  },
];

// The order comes from the room pages in the content draft. The director confirms the times.
const day = [
  { time: '7am', activity: 'Arrive and free play' },
  { time: '9am', activity: 'Group time' },
  { time: '9:30am', activity: 'Morning tea' },
  { time: '10am', activity: 'Outdoor play' },
  { time: '11:30am', activity: 'Lunch', note: true },
  { time: '12:30pm', activity: 'Rest' },
  { time: '2:30pm', activity: 'Art, music and messy play' },
  { time: 'By 6pm', activity: 'Pick-up' },
];

const educators = [
  { role: 'Director', crayon: 'green' },
  { role: 'Room leader', crayon: 'blue' },
  { role: 'Room leader', crayon: 'red' },
];
---

<Layout
  title="Rainbow Village Childcare Harris Park | Family-Run Long Day Care"
  description="Family-run childcare in Harris Park for children from 6 weeks to 6 years. Meals cooked fresh on site, caring educators, 4.8 stars on Google. Book a tour."
  schema={childCare}
>
  <!-- Hero: bright green, the page's one big colour moment. The rating is live from the Places API once that is set up. -->
  <section class="hs-band hs-band--sky hs-band--flat-top hs-hero" data-theme="crayon">
    <div class="hs-hero__grid">
      <div class="hs-hero__words">
        <h1 class="hs-hero__title rv-hero-title"><span>Muddy knees,</span> <span>full tummies,</span> <span>big ideas</span></h1>
        <p class="hs-hero__lead">Family-run childcare in Harris Park for children from 6 weeks to 6 years.</p>
        <div class="hs-hero__actions rv-hero-actions">
          <a class="hs-btn hs-btn--orange" href="/book-a-tour">Book a tour</a>
          <a class="hs-btn hs-btn--yellow" href={site.phoneHref}>Call {site.phone}</a>
        </div>
        <p class="rv-rating">{site.rating}</p>
      </div>
      <div class="hs-hero__line" aria-hidden="true">
        <!-- Children's real paintings replace these once the centre sends them. -->
        <ul class="hs-line rv-hero-paintings">
          <li><div class="hs-painting hs-painting--purple" data-theme="crayon"><div class="hs-painting__art"><i></i><i></i><i></i></div></div></li>
          <li><div class="hs-painting" data-theme="crayon"><div class="hs-painting__art"><i></i><i></i><i></i></div></div></li>
          <li><div class="hs-painting hs-painting--orange" data-theme="crayon"><div class="hs-painting__art"><i></i><i></i><i></i></div></div></li>
        </ul>
      </div>
    </div>
    <div class="hs-hero__land" aria-hidden="true"><i></i><i></i><i></i></div>
  </section>

  <!-- Why families choose us: three facts and one taped photo, no icon grid -->
  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-split">
      <div class="rv-stack-lg">
        <h2 class="hs-title">A second home, not just a centre</h2>
        {reasons.map((reason) => <p><b>{reason.title}</b> {reason.text}</p>)}
        <p>
          <b>Rated Meeting the National Quality Standard.</b>
          <mark class="rv-todo">[Child Care Subsidy approved: wording from the centre]</mark>
        </p>
      </div>
      <figure class="hs-painting hs-painting--blue rv-taped" data-theme="crayon">
        <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>
        <figcaption class="hs-painting__caption">A real photo of the centre goes here.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Our rooms: the main path deeper into the site -->
  <section class="hs-band hs-band--sky" data-theme="kraft">
    <div class="hs-band__inner">
      <div class="rv-stack">
        <h2 class="hs-title">A room for every stage</h2>
        <p>Three rooms, grouped by age. Tap a room to see inside.</p>
      </div>
      <ul class="hs-line rv-line-stack">
        {rooms.map((room) => (
          <li>
            <RoomCard title={room.name} ages={room.ages} text={room.text} href={room.href} crayon={room.crayon as 'purple' | 'yellow' | 'orange'} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- A day here: the timetable sits on the ruled lines -->
  <section class="hs-sheet" data-theme="crayon">
    <div class="rv-wrap rv-sheet-body">
      <h2>A day here</h2>
      <p>Each room keeps its own rhythm, but most days follow this shape.</p>
      <dl class="rv-day">
        {day.map((item) => (
          <div>
            <dt><mark class="rv-todo">[{item.time}]</mark></dt>
            <dd>
              {item.note && <a class="hs-sheet__note" href="/weekly-menu" aria-label="This week's menu">Menu</a>}
              {item.activity}
            </dd>
          </div>
        ))}
      </dl>
      <p><a href="/weekly-menu">See what's for lunch this week</a></p>
    </div>
  </section>

  <!-- Featured reviews: label, overall rating and a link to all of them (ACCC guidance) -->
  <section class="hs-band hs-band--purple" data-theme="kraft">
    <div class="hs-band__inner rv-stack-lg">
      <div class="rv-stack">
        <h2 class="hs-title">Loved by Harris Park families</h2>
        <p>Featured reviews. We have {site.rating} overall.</p>
      </div>
      <ReviewsSlider client:visible reviews={reviews} />
      <p><a href={site.reviewsUrl}>Read all reviews on Google</a></p>
    </div>
  </section>

  <!-- See inside: the video, then the people. Portraits fall back to initials if a staff member prefers. -->
  <section class="hs-ground rv-section" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <div class="rv-stack">
        <h2 class="hs-title">Take a look inside</h2>
        <p>See our rooms, our playground and our kitchen in 90 seconds.</p>
      </div>
      <div class="rv-split rv-inside">
        <ul class="hs-line rv-line-single">
          <li>
            <figure class="hs-painting rv-poster">
              <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>
              <figcaption class="hs-painting__caption">The centre video goes here after filming day.</figcaption>
            </figure>
          </li>
        </ul>
        <div class="rv-stack-lg">
          <h3>Meet some of our educators</h3>
          <ul class="hs-line rv-line-stack rv-line-stack--straight rv-portraits">
            {educators.map((educator) => (
              <li>
                <a class={`hs-painting hs-painting--${educator.crayon}`} href="/our-team" aria-label={`Meet our team: ${educator.role}`}>
                  <div class="hs-painting__art" aria-hidden="true"><i></i><i></i><i></i></div>
                  <span class="hs-tape"><mark class="rv-todo">[Name]</mark></span>
                  <p class="hs-painting__caption">{educator.role}</p>
                </a>
              </li>
            ))}
          </ul>
          <p><a href="/our-team">Meet the whole team</a></p>
        </div>
      </div>
    </div>
  </section>

  <Closing title="Come and see us" text="Tours take about 30 minutes." band="green" />
</Layout>
