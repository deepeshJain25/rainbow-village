---
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import faqs from '../content/faqs.json';
import site from '../content/site.json';
import Layout from '../layouts/Layout.astro';

// Answers keep their link text but lose the link markup and the to-confirm brackets.
const plain = (text: string) => text.replace(/\{([^}]+)\}\([^)]+\)/g, '$1').replace(/\s*\[[^\]]*\]/g, '').trim();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // An answer still missing a fact (a bracket before its end) stays out until the centre confirms it.
  mainEntity: faqs.flatMap((group) => group.items).filter((item) => !/\[[^\]]*\](?!\s*$)/.test(item.a)).map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: plain(item.a) },
  })),
};
---

<Layout
  title="Childcare FAQs Harris Park | Fees, Meals, Ages | Rainbow Village"
  description="Answers about our Harris Park childcare centre: ages, fees and CCS, halal and nut-aware meals, hours, languages and settling in."
  schema={schema}
>
  <PageHeader
    title="Childcare questions parents ask us"
    current="FAQs"
    lead={`Answers about Rainbow Village Childcare in Harris Park. Can't see your question? Call ${site.phone} or ask on your tour.`}
    crumbs={[{ label: 'Parents', href: '/for-parents' }]}
  />

  <section class="hs-ground rv-section rv-section--flush" data-theme="crayon">
    <div class="rv-wrap rv-stack-lg">
      <ul class="rv-tapes">
        {faqs.map((group) => <li><a class="hs-tape" href={`#${group.slug}`}>{group.topic}</a></li>)}
      </ul>
      {faqs.map((group) => (
        <div class="rv-details-list" id={group.slug}>
          <h2>{group.topic}</h2>
          {group.items.map((item) => (
            <details class="rv-details">
              <summary>{item.q}<Icon name="chevron-down" /></summary>
              <div class="rv-details__body">
                <p><Todo text={item.a} /></p>
              </div>
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>
</Layout>
